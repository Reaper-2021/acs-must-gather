#!/bin/bash

# ACS Must-Gather - Advanced: Vulnerability & Violation Report
#
# Snapshots the image-scan / CVE and policy-violation data that Central holds,
# so it can be triaged offline (e.g. with analysis/acs-analyze --image <name>)
# long after the must-gather was taken. The officially-supported bundle and
# debug dump describe Central's *health*; they do NOT contain the per-image CVE
# findings or the violation list a support case usually turns on.
#
# Everything is pulled from Central's REST API over a short-lived port-forward,
# authenticating with the admin password from central-htpasswd - the same
# mechanism gather_debug_dump / gather_diagnostic_bundle already use. Central
# container images ship no curl/wget, so we curl from this (must-gather)
# container. Admin basic-auth maps to the built-in Admin role, which authorizes
# every endpoint below across all clusters/namespaces.
#
# Written to advanced-acs-diagnostics/vuln-report/:
#   vuln-mgmt-workloads.json        - GET /v1/export/vuln-mgmt/workloads
#                                     (streaming: every deployment joined to its
#                                     images and full CVE data; the primary
#                                     machine-readable dataset for the analyzer)
#   image-cves.csv                  - GET /api/vm/export/csv?query=CVE Type:IMAGE_CVE
#                                     (human-readable, opens in any spreadsheet)
#   violations.json                 - GET /v1/alerts (paged; policy violations)
#   alerts-summary-counts-*.json    - GET /v1/alerts/summary/counts (rollups)
#   collection-info.txt             - source endpoints + row/byte counts
#
# Best-effort and isolated like every advanced sub-collector: any failure writes
# a .error / collection-error.txt file and the script still exits 0.

# shellcheck source=collection-scripts/common.sh
source /usr/bin/common.sh

log_msg "--- gather_advanced_vuln_report: starting ---"

OUT_DIR="${MUST_GATHER_DIR}/advanced-acs-diagnostics/vuln-report"
mkdir -p "${OUT_DIR}"

# The streaming vuln export can be large on big clusters; allow a generous
# default. Individual smaller calls reuse the same budget.
VULN_TIMEOUT="${ADV_VULN_TIMEOUT:-300}"

# Which violation states to snapshot. Default to the actionable ones to keep the
# bundle bounded on long-lived clusters; set ADV_VULN_ALERT_STATES to include
# RESOLVED/SNOOZED for a full history, e.g.
#   ADV_VULN_ALERT_STATES="ACTIVE,ATTEMPTED,RESOLVED,SNOOZED"
ALERT_STATES="${ADV_VULN_ALERT_STATES:-ACTIVE,ATTEMPTED}"

# ---------- Find running Central pod ----------
CENTRAL_POD=""
CENTRAL_NS=""
while IFS= read -r ns; do
    [[ -z "${ns}" ]] && continue
    pod=$(oc get pods -n "${ns}" -l app=central \
        --field-selector=status.phase=Running \
        -o jsonpath='{.items[0].metadata.name}' 2>/dev/null) || true
    if [[ -n "${pod}" ]]; then
        CENTRAL_POD="${pod}"
        CENTRAL_NS="${ns}"
        break
    fi
done <<< "${ACS_NAMESPACES}"

if [[ -z "${CENTRAL_POD}" ]]; then
    log_msg "WARNING: No running Central pod found. Skipping vuln report collection."
    echo "No running Central pod found." > "${OUT_DIR}/collection-error.txt"
    exit 0
fi
log_msg "Found Central pod: ${CENTRAL_POD} in namespace ${CENTRAL_NS}"

# ---------- Retrieve admin credentials ----------
ADMIN_PASSWORD=$(oc get secret -n "${CENTRAL_NS}" central-htpasswd \
    -o jsonpath='{.data.password}' 2>/dev/null | base64 -d 2>/dev/null) || true
if [[ -z "${ADMIN_PASSWORD}" ]]; then
    ADMIN_PASSWORD=$(oc get secret -n "${CENTRAL_NS}" stackrox-admin-password \
        -o jsonpath='{.data.password}' 2>/dev/null | base64 -d 2>/dev/null) || true
fi
if [[ -z "${ADMIN_PASSWORD}" ]]; then
    log_msg "WARNING: Could not retrieve Central admin password; cannot query the API."
    echo "Could not retrieve Central admin password (checked central-htpasswd and stackrox-admin-password)." \
        > "${OUT_DIR}/collection-error.txt"
    exit 0
fi

# ---------- Set up port-forward to Central ----------
PF_LOG="$(mktemp)"
oc port-forward -n "${CENTRAL_NS}" "${CENTRAL_POD}" ":8443" > "${PF_LOG}" 2>&1 &
PF_PID=$!

LOCAL_PORT=""
for _ in $(seq 1 20); do
    LOCAL_PORT=$(grep -oE 'Forwarding from 127\.0\.0\.1:[0-9]+' "${PF_LOG}" 2>/dev/null \
        | grep -oE '[0-9]+$' | head -1)
    [[ -n "${LOCAL_PORT}" ]] && break
    kill -0 "${PF_PID}" 2>/dev/null || break
    sleep 0.5
done

if [[ -z "${LOCAL_PORT}" ]] || ! kill -0 "${PF_PID}" 2>/dev/null; then
    log_msg "ERROR: Port-forward to Central failed to establish"
    echo "Port-forward to Central failed to establish." > "${OUT_DIR}/collection-error.txt"
    kill "${PF_PID}" 2>/dev/null || true
    rm -f "${PF_LOG}"
    exit 0
fi
log_msg "Port-forward established on local port ${LOCAL_PORT} (PID: ${PF_PID})"

# Keep the admin password off the curl command line (visible via ps / /proc):
# write it to a temporary curl config (mode 600) and pass it via --config.
CURL_CONFIG="$(mktemp)"
chmod 600 "${CURL_CONFIG}"
printf 'user = "admin:%s"\n' "${ADMIN_PASSWORD}" > "${CURL_CONFIG}"

cleanup() {
    kill "${PF_PID}" 2>/dev/null || true
    wait "${PF_PID}" 2>/dev/null || true
    rm -f "${CURL_CONFIG}" "${PF_LOG}"
}
trap cleanup EXIT

# fetch <path> <outfile> [label]
# GET https://127.0.0.1:<port><path> with admin basic-auth into <outfile>.
# Best-effort: on non-200 / transport failure writes <outfile>.error and returns
# 1, but never aborts the script. -k is intentional (self-signed localhost cert).
fetch() {
    local path="$1" outfile="$2" label="${3:-$1}"
    local http_code
    http_code=$(timeout "${VULN_TIMEOUT}" \
        curl -sSk -w '%{http_code}' -o "${outfile}" \
        --config "${CURL_CONFIG}" \
        "https://127.0.0.1:${LOCAL_PORT}${path}" 2>/dev/null) || http_code="000"
    if [[ "${http_code}" != "200" ]]; then
        log_msg "  WARNING: ${label} failed (HTTP ${http_code})"
        {
            echo "Failed to fetch ${path}"
            echo "HTTP status: ${http_code}"
            echo "(HTTP 000 indicates a timeout or transport-level failure)"
        } > "${outfile}.error"
        rm -f "${outfile}" 2>/dev/null || true
        return 1
    fi
    return 0
}

# ---------- 1. Image + CVE data (streaming vuln-mgmt export) ----------
# Deployments joined to their images with full per-CVE detail. One streaming
# call, bypasses the 1000-image list cap. Empty query = every workload.
log_msg "Collecting image/CVE data from /v1/export/vuln-mgmt/workloads"
fetch "/v1/export/vuln-mgmt/workloads" "${OUT_DIR}/vuln-mgmt-workloads.json" \
    "vuln-mgmt workloads export" || true

# ---------- 2. Image CVEs as CSV (human-readable) ----------
# The CVE CSV handler requires a "CVE Type" filter; IMAGE_CVE scopes it to
# container-image CVEs. Space and colon are URL-encoded.
log_msg "Collecting image CVE CSV from /api/vm/export/csv"
fetch "/api/vm/export/csv?query=CVE%20Type%3AIMAGE_CVE" "${OUT_DIR}/image-cves.csv" \
    "image CVE CSV" || true

# ---------- 3. Policy violations (paged) ----------
# /v1/alerts returns summaries only and defaults to ACTIVE unless a Violation
# State filter is supplied. Page in fixed chunks and merge, so a large cluster
# never forces one giant in-memory response.
log_msg "Collecting policy violations from /v1/alerts (states: ${ALERT_STATES})"
STATE_Q=$(printf '%s' "${ALERT_STATES}" | sed 's/,/%2C/g')
ALERT_QUERY="Violation%20State%3A${STATE_Q}"
PAGE_LIMIT=1000
OFFSET=0
PAGE=0
PAGE_FILES=()
ALERT_OK=true
while :; do
    page_file="$(mktemp)"
    if ! fetch \
        "/v1/alerts?query=${ALERT_QUERY}&pagination.limit=${PAGE_LIMIT}&pagination.offset=${OFFSET}" \
        "${page_file}" "violations page $((PAGE + 1))"; then
        ALERT_OK=false
        rm -f "${page_file}"
        break
    fi
    got=$(jq '.alerts | length' "${page_file}" 2>/dev/null) || got=0
    [[ -z "${got}" || "${got}" == "null" ]] && got=0
    PAGE_FILES+=("${page_file}")
    [[ "${got}" -lt "${PAGE_LIMIT}" ]] && break
    OFFSET=$((OFFSET + PAGE_LIMIT))
    PAGE=$((PAGE + 1))
    # Safety stop: 100 pages = 100k alerts. Note the truncation rather than
    # silently capping.
    if [[ "${PAGE}" -ge 100 ]]; then
        log_msg "  NOTE: reached 100-page cap; violations.json is truncated at ${OFFSET} alerts"
        echo "Violation collection stopped at the ${OFFSET}-alert safety cap; result is truncated." \
            > "${OUT_DIR}/violations.json.truncated"
        break
    fi
done

if [[ "${ALERT_OK}" == "true" && "${#PAGE_FILES[@]}" -gt 0 ]]; then
    if jq -s '{alerts: (map(.alerts // []) | add)}' "${PAGE_FILES[@]}" \
        > "${OUT_DIR}/violations.json" 2>/dev/null; then
        ALERT_COUNT=$(jq '.alerts | length' "${OUT_DIR}/violations.json" 2>/dev/null || echo "?")
        log_msg "  Collected ${ALERT_COUNT} violation(s)"
    else
        log_msg "  WARNING: failed to merge violation pages"
        echo "Failed to merge paged /v1/alerts responses." > "${OUT_DIR}/violations.json.error"
    fi
fi
rm -f "${PAGE_FILES[@]}" 2>/dev/null || true

# ---------- 4. Violation rollups (cheap aggregates) ----------
log_msg "Collecting violation rollups from /v1/alerts/summary/counts"
fetch "/v1/alerts/summary/counts?request.query=${ALERT_QUERY}&group_by=CLUSTER" \
    "${OUT_DIR}/alerts-summary-counts-by-cluster.json" "alerts counts by cluster" || true
fetch "/v1/alerts/summary/counts?request.query=${ALERT_QUERY}&group_by=CATEGORY" \
    "${OUT_DIR}/alerts-summary-counts-by-category.json" "alerts counts by category" || true

# ---------- Provenance ----------
{
    echo "source: RHACS Central REST API (admin basic-auth over port-forward)"
    echo "central-namespace: ${CENTRAL_NS}"
    echo "central-pod: ${CENTRAL_POD}"
    echo "collected-at: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    echo "alert-states: ${ALERT_STATES}"
    echo
    echo "endpoints:"
    echo "  vuln-mgmt-workloads.json <- GET /v1/export/vuln-mgmt/workloads"
    echo "  image-cves.csv           <- GET /api/vm/export/csv?query=CVE Type:IMAGE_CVE"
    echo "  violations.json          <- GET /v1/alerts?query=Violation State:${ALERT_STATES} (paged)"
    echo "  alerts-summary-counts-*  <- GET /v1/alerts/summary/counts?group_by=CLUSTER|CATEGORY"
    echo
    echo "sizes:"
    for f in vuln-mgmt-workloads.json image-cves.csv violations.json \
             alerts-summary-counts-by-cluster.json alerts-summary-counts-by-category.json; do
        if [[ -f "${OUT_DIR}/${f}" ]]; then
            printf '  %-40s %s bytes\n' "${f}" "$(wc -c < "${OUT_DIR}/${f}" | tr -d ' ')"
        else
            printf '  %-40s (not collected)\n' "${f}"
        fi
    done
} > "${OUT_DIR}/collection-info.txt"

log_msg "--- gather_advanced_vuln_report: complete ---"
