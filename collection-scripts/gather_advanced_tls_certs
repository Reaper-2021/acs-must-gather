#!/bin/bash

# ACS Must-Gather - Advanced: TLS Certificate Expiry Report
#
# RHACS mTLS problems ("Sensor won't connect", handshake failures) are very
# often expired or mismatched service certificates - but `oc adm inspect`
# redacts Secret contents, so certificate expiry is invisible in a normal
# must-gather. This collector decodes ONLY the PUBLIC certificate material from
# RHACS TLS secrets and records subject / issuer / validity / serial.
#
# SAFETY: private keys are never read. Only data keys that hold a certificate
# (ca.pem, tls.crt, *-cert.pem, cert.pem) are decoded, any key whose name
# contains "key" is skipped, and openssl is asked only for metadata
# (-subject -issuer -dates -serial), never the certificate body.

# shellcheck source=collection-scripts/common.sh
source /usr/bin/common.sh

log_msg "--- gather_advanced_tls_certs: starting ---"

OUT_DIR="${MUST_GATHER_DIR}/advanced-acs-diagnostics/tls-certs"
mkdir -p "${OUT_DIR}"
SUMMARY="${OUT_DIR}/cert-expiry-summary.txt"

if ! command -v openssl >/dev/null 2>&1; then
    log_msg "WARNING: openssl not available; skipping TLS cert report"
    echo "openssl not available in the must-gather image; cannot decode certificates." \
        > "${OUT_DIR}/collection-error.txt"
    exit 0
fi

{
    echo "# RHACS TLS certificate expiry report"
    echo "# generated: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    echo "# Public certificate metadata only - no private keys are read."
    echo
} > "${SUMMARY}"

# Namespaces to scan: all ACS workload namespaces plus the operator namespace.
SCAN_NS="${ACS_NAMESPACES}"
[[ -n "${OPERATOR_NS:-}" ]] && SCAN_NS="${SCAN_NS}"$'\n'"${OPERATOR_NS}"
SCAN_NS="$(echo "${SCAN_NS}" | sort -u | grep -v '^$')"

# is_cert_key <keyname> -> 0 if it holds a public cert we should decode
is_cert_key() {
    local k="$1"
    case "${k}" in
        *key*) return 1 ;;                             # never touch private keys
        ca.pem|tls.crt|cert.pem|*-cert.pem|*.crt) return 0 ;;
        *) return 1 ;;
    esac
}

while IFS= read -r ns; do
    [[ -z "${ns}" ]] && continue

    # RHACS TLS / init-bundle secrets in this namespace.
    secrets=$(oc get secrets -n "${ns}" -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null \
        | grep -iE 'tls|init-bundle' || true)
    [[ -z "${secrets}" ]] && continue

    while IFS= read -r secret; do
        [[ -z "${secret}" ]] && continue

        keys=$(oc get secret -n "${ns}" "${secret}" -o json 2>/dev/null \
            | jq -r '.data // {} | keys[]' 2>/dev/null)
        [[ -z "${keys}" ]] && continue

        while IFS= read -r key; do
            [[ -z "${key}" ]] && continue
            is_cert_key "${key}" || continue

            cert_pem=$(oc get secret -n "${ns}" "${secret}" \
                -o jsonpath="{.data.${key//./\\.}}" 2>/dev/null | base64 -d 2>/dev/null) || true
            [[ -z "${cert_pem}" ]] && continue

            # Only proceed if it really parses as an X.509 certificate.
            if ! echo "${cert_pem}" | openssl x509 -noout 2>/dev/null; then
                continue
            fi

            {
                echo "=== ${ns}/${secret} [${key}] ==="
                echo "${cert_pem}" | openssl x509 -noout -subject -issuer -serial -startdate -enddate 2>/dev/null
                # Flag certs expiring within 30 days.
                if echo "${cert_pem}" | openssl x509 -noout -checkend $((30*24*3600)) >/dev/null 2>&1; then
                    echo "status: OK (>30d remaining)"
                else
                    if echo "${cert_pem}" | openssl x509 -noout -checkend 0 >/dev/null 2>&1; then
                        echo "status: WARNING - expires within 30 days"
                    else
                        echo "status: EXPIRED"
                    fi
                fi
                echo
            } >> "${SUMMARY}"
            log_msg "  Recorded cert ${ns}/${secret}[${key}]"
        done <<< "${keys}"
    done <<< "${secrets}"
done <<< "${SCAN_NS}"

if [[ ! -s "${SUMMARY}" ]] || [[ "$(grep -c '===' "${SUMMARY}")" == "0" ]]; then
    echo "No RHACS TLS certificates were found to decode." >> "${SUMMARY}"
fi

log_msg "--- gather_advanced_tls_certs: complete ---"
