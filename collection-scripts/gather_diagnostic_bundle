#!/bin/bash

# ACS Must-Gather - RHACS Diagnostic Bundle
#
# Collects the full RHACS diagnostic bundle - the same data produced by
# "roxctl central debug download-diagnostics" - and extracts it into the
# acs-diagnostic-bundle/ folder of the must-gather.
#
# This is the deep RHACS diagnostic layer: Central + every connected Secured
# Cluster (versions, Prometheus metrics, profiles, Central-DB Postgres stats,
# system configuration, scrubbed auth/notifier config, telemetry, and
# Kubernetes introspection with pod logs and events). It complements the
# platform-level data collected by the rest of acs-must-gather.
#
# Central serves the bundle at GET /api/extensions/diagnostics, which requires
# admin authentication. Central container images do not ship curl/wget, so we
# port-forward to Central and download the bundle with curl from this
# (must-gather) container, authenticating with the admin password from the
# central-htpasswd secret.

# shellcheck source=collection-scripts/common.sh
source /usr/bin/common.sh

log_msg "--- gather_diagnostic_bundle: starting ---"

BUNDLE_DIR="${MUST_GATHER_DIR}/acs-diagnostic-bundle"
mkdir -p "${BUNDLE_DIR}"

# roxctl central debug download-diagnostics defaults to a 5 minute timeout.
BUNDLE_TIMEOUT="${DIAG_BUNDLE_TIMEOUT:-300}"

# ---------- Find running Central pod ----------
CENTRAL_POD=""
CENTRAL_NS=""

while IFS= read -r ns; do
    [[ -z "${ns}" ]] && continue
    pod=$(oc get pods -n "${ns}" -l app=central \
        --field-selector=status.phase=Running \
        -o jsonpath='{.items[0].metadata.name}' 2>/dev/null) || true
    if [[ -n "${pod}" ]]; then
        CENTRAL_POD="${pod}"
        CENTRAL_NS="${ns}"
        break
    fi
done <<< "${ACS_NAMESPACES}"

if [[ -z "${CENTRAL_POD}" ]]; then
    log_msg "WARNING: No running Central pod found. Skipping diagnostic bundle collection."
    echo "No running Central pod found." > "${BUNDLE_DIR}/collection-error.txt"
    exit 0
fi

log_msg "Found Central pod: ${CENTRAL_POD} in namespace ${CENTRAL_NS}"

# ---------- Retrieve admin credentials ----------
# The diagnostic bundle endpoint requires admin authentication. Try the current
# central-htpasswd secret first, then the legacy secret name.
ADMIN_PASSWORD=$(oc get secret -n "${CENTRAL_NS}" central-htpasswd \
    -o jsonpath='{.data.password}' 2>/dev/null | base64 -d 2>/dev/null) || true
if [[ -z "${ADMIN_PASSWORD}" ]]; then
    ADMIN_PASSWORD=$(oc get secret -n "${CENTRAL_NS}" stackrox-admin-password \
        -o jsonpath='{.data.password}' 2>/dev/null | base64 -d 2>/dev/null) || true
fi
if [[ -z "${ADMIN_PASSWORD}" ]]; then
    log_msg "WARNING: Could not retrieve Central admin password; cannot download diagnostic bundle."
    echo "Could not retrieve Central admin password (checked central-htpasswd and stackrox-admin-password)." \
        > "${BUNDLE_DIR}/collection-error.txt"
    exit 0
fi

# ---------- Set up port-forward to Central ----------
# Let oc/kubectl pick a free local port and report it, so this can run
# concurrently with other port-forwarding gatherers without racing on a port.
PF_LOG="$(mktemp)"
oc port-forward -n "${CENTRAL_NS}" "${CENTRAL_POD}" ":8443" > "${PF_LOG}" 2>&1 &
PF_PID=$!

LOCAL_PORT=""
for _ in $(seq 1 20); do
    LOCAL_PORT=$(grep -oE 'Forwarding from 127\.0\.0\.1:[0-9]+' "${PF_LOG}" 2>/dev/null \
        | grep -oE '[0-9]+$' | head -1)
    [[ -n "${LOCAL_PORT}" ]] && break
    kill -0 "${PF_PID}" 2>/dev/null || break
    sleep 0.5
done

if [[ -z "${LOCAL_PORT}" ]] || ! kill -0 "${PF_PID}" 2>/dev/null; then
    log_msg "ERROR: Port-forward to Central failed to establish"
    echo "Port-forward to Central failed to establish." > "${BUNDLE_DIR}/collection-error.txt"
    kill "${PF_PID}" 2>/dev/null || true
    rm -f "${PF_LOG}"
    exit 0
fi
log_msg "Port-forward established on local port ${LOCAL_PORT} (PID: ${PF_PID})"

# Keep the admin password off the curl command line (visible via ps / /proc):
# write it to a temporary curl config (mode 600) and pass it via --config.
CURL_CONFIG="$(mktemp)"
chmod 600 "${CURL_CONFIG}"
printf 'user = "admin:%s"\n' "${ADMIN_PASSWORD}" > "${CURL_CONFIG}"

BUNDLE_ZIP="$(mktemp)"

cleanup() {
    kill "${PF_PID}" 2>/dev/null || true
    wait "${PF_PID}" 2>/dev/null || true
    rm -f "${CURL_CONFIG}" "${PF_LOG}" "${BUNDLE_ZIP}"
}
trap cleanup EXIT

# ---------- Build the request (mirrors roxctl download-diagnostics flags) ----------
# Defaults match "roxctl central debug download-diagnostics" with no flags.
QUERY_PARTS=()

# --since <RFC3339>: fall back to the must-gather time bound when set.
SINCE="${DIAG_BUNDLE_SINCE:-${MUST_GATHER_SINCE_TIME:-}}"
[[ -n "${SINCE}" ]] && QUERY_PARTS+=("since=${SINCE}")

# --clusters <a,b,c>: repeat the cluster parameter for each name.
if [[ -n "${DIAG_BUNDLE_CLUSTERS:-}" ]]; then
    IFS=',' read -ra _clusters <<< "${DIAG_BUNDLE_CLUSTERS}"
    for c in "${_clusters[@]}"; do
        c="${c#"${c%%[![:space:]]*}"}"; c="${c%"${c##*[![:space:]]}"}"
        [[ -n "${c}" ]] && QUERY_PARTS+=("cluster=${c}")
    done
fi

# --with-compliance-operator
[[ "${DIAG_BUNDLE_COMPLIANCE_OPERATOR:-false}" == "true" ]] && QUERY_PARTS+=("compliance-operator=true")

# --with-database-only
[[ "${DIAG_BUNDLE_DATABASE_ONLY:-false}" == "true" ]] && QUERY_PARTS+=("database-only=true")

QUERY=""
if [[ ${#QUERY_PARTS[@]} -gt 0 ]]; then
    QUERY="?$(IFS='&'; echo "${QUERY_PARTS[*]}")"
fi

BUNDLE_URL="https://127.0.0.1:${LOCAL_PORT}/api/extensions/diagnostics${QUERY}"

# ---------- Download the bundle ----------
# -k is intentional: Central serves a self-signed cert on the localhost
# port-forward, so CA/hostname verification does not apply.
log_msg "Downloading diagnostic bundle from /api/extensions/diagnostics${QUERY}"
HTTP_CODE=$(timeout "${BUNDLE_TIMEOUT}" \
    curl -sSk -w '%{http_code}' -o "${BUNDLE_ZIP}" \
    --config "${CURL_CONFIG}" \
    "${BUNDLE_URL}" 2>/dev/null) || HTTP_CODE="000"

if [[ "${HTTP_CODE}" != "200" ]]; then
    log_msg "WARNING: Diagnostic bundle download failed (HTTP ${HTTP_CODE})"
    {
        echo "Failed to download diagnostic bundle from ${BUNDLE_URL}"
        echo "HTTP status: ${HTTP_CODE}"
        echo "(HTTP 000 indicates a timeout or transport-level failure)"
    } > "${BUNDLE_DIR}/collection-error.txt"
    exit 0
fi

# ---------- Extract into the bundle folder ----------
if ! unzip -tq "${BUNDLE_ZIP}" >/dev/null 2>&1; then
    log_msg "WARNING: Downloaded diagnostic bundle is not a valid zip; keeping raw file"
    cp "${BUNDLE_ZIP}" "${BUNDLE_DIR}/diagnostic-bundle.zip"
    echo "Downloaded response was not a valid zip archive; saved as diagnostic-bundle.zip for inspection." \
        > "${BUNDLE_DIR}/collection-error.txt"
    exit 0
fi

if unzip -oq "${BUNDLE_ZIP}" -d "${BUNDLE_DIR}" 2>/dev/null; then
    FILE_COUNT=$(find "${BUNDLE_DIR}" -type f ! -name 'collection-info.txt' | wc -l | tr -d ' ')
    log_msg "Diagnostic bundle extracted into acs-diagnostic-bundle/ (${FILE_COUNT} files)"
    {
        echo "source-endpoint: /api/extensions/diagnostics${QUERY}"
        echo "equivalent-command: roxctl central debug download-diagnostics"
        echo "central-namespace: ${CENTRAL_NS}"
        echo "central-pod: ${CENTRAL_POD}"
        echo "collected-at: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
        echo "files-extracted: ${FILE_COUNT}"
    } > "${BUNDLE_DIR}/collection-info.txt"
else
    log_msg "WARNING: Failed to extract diagnostic bundle; keeping raw zip"
    cp "${BUNDLE_ZIP}" "${BUNDLE_DIR}/diagnostic-bundle.zip"
    echo "Bundle downloaded but extraction failed; saved as diagnostic-bundle.zip." \
        > "${BUNDLE_DIR}/collection-error.txt"
fi

log_msg "--- gather_diagnostic_bundle: complete ---"
