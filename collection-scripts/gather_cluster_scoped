#!/bin/bash

# ACS Must-Gather - Cluster-Scoped Resources
# Collects CRDs, CR instances, webhooks, RBAC, SCCs, and node info.

# shellcheck source=collection-scripts/common.sh
source /usr/bin/common.sh

log_msg "--- gather_cluster_scoped: starting ---"

# ---------- CRDs ----------
log_msg "Collecting ACS CRDs..."
ACS_CRDS="$(discover_acs_crds)"
if [[ -n "${ACS_CRDS}" ]]; then
    while IFS= read -r crd; do
        [[ -z "${crd}" ]] && continue
        inspect_resource "crd/${crd}"
    done <<< "${ACS_CRDS}"
else
    log_msg "WARNING: No ACS CRDs found via dynamic discovery. Trying known names."
    for crd in centrals.platform.stackrox.io securedclusters.platform.stackrox.io securitypolicies.config.stackrox.io; do
        if resource_exists "crd/${crd}"; then
            inspect_resource "crd/${crd}"
        fi
    done
fi

# ---------- CR instances (cluster-wide) ----------
log_msg "Collecting ACS CR instances..."
for cr_kind in Central SecuredCluster; do
    if oc get "${cr_kind}" -A &>/dev/null 2>&1; then
        inspect_resource "${cr_kind}" "" "--all-namespaces"
    fi
done

# ---------- ValidatingWebhookConfigurations ----------
log_msg "Collecting ValidatingWebhookConfigurations..."
VWC_NAMES=$(oc get validatingwebhookconfigurations \
    -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null \
    | grep -iE "stackrox|rhacs|admission-control" || true)
while IFS= read -r vwc; do
    [[ -z "${vwc}" ]] && continue
    inspect_resource "validatingwebhookconfigurations/${vwc}"
done <<< "${VWC_NAMES}"

# ---------- MutatingWebhookConfigurations ----------
MWC_NAMES=$(oc get mutatingwebhookconfigurations \
    -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null \
    | grep -iE "stackrox|rhacs" || true)
while IFS= read -r mwc; do
    [[ -z "${mwc}" ]] && continue
    inspect_resource "mutatingwebhookconfigurations/${mwc}"
done <<< "${MWC_NAMES}"

# ---------- ClusterRoles ----------
log_msg "Collecting ACS RBAC resources..."
CR_NAMES=$(oc get clusterroles \
    -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null \
    | grep -i "stackrox" || true)
while IFS= read -r cr_name; do
    [[ -z "${cr_name}" ]] && continue
    inspect_resource "clusterrole/${cr_name}"
done <<< "${CR_NAMES}"

# ---------- ClusterRoleBindings ----------
CRB_NAMES=$(oc get clusterrolebindings \
    -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null \
    | grep -i "stackrox" || true)
while IFS= read -r crb_name; do
    [[ -z "${crb_name}" ]] && continue
    inspect_resource "clusterrolebinding/${crb_name}"
done <<< "${CRB_NAMES}"

# ---------- SecurityContextConstraints (OpenShift only) ----------
if oc api-resources --api-group=security.openshift.io &>/dev/null 2>&1; then
    log_msg "Collecting StackRox SCCs..."
    SCC_NAMES=$(oc get scc \
        -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null \
        | grep -i "stackrox" || true)
    while IFS= read -r scc_name; do
        [[ -z "${scc_name}" ]] && continue
        inspect_resource "scc/${scc_name}"
    done <<< "${SCC_NAMES}"
fi

# ---------- Nodes ----------
log_msg "Collecting node summary..."
mkdir -p "${MUST_GATHER_DIR}/cluster-scoped-resources/core"
oc get nodes -o wide > "${MUST_GATHER_DIR}/cluster-scoped-resources/core/nodes-summary.txt" 2>/dev/null || true

# Node-to-kernel matrix: pins each node's OS image and kernel version so a
# Collector CrashLoopBackOff after a node upgrade can be tied to the kernel it
# is running on (see the advanced Scanner V4 / Collector triage).
oc get nodes \
    -o custom-columns=NAME:.metadata.name,OS-IMAGE:.status.nodeInfo.osImage,KERNEL-VERSION:.status.nodeInfo.kernelVersion,RUNTIME:.status.nodeInfo.containerRuntimeVersion \
    > "${MUST_GATHER_DIR}/cluster-scoped-resources/core/node-kernel-matrix.txt" 2>/dev/null || true

# ---------- ClusterVersion (OpenShift only) ----------
# Channel, desired/current version, and upgrade history - essential context for
# any "broke after an upgrade" case.
if oc api-resources --api-group=config.openshift.io &>/dev/null 2>&1; then
    log_msg "Collecting ClusterVersion..."
    inspect_resource "clusterversion.config.openshift.io"
fi

# ---------- StorageClasses ----------
# Central-DB PVC binding problems often trace back to the default/provisioner
# StorageClass, which oc adm inspect does not otherwise collect.
log_msg "Collecting StorageClasses..."
inspect_resource "storageclasses.storage.k8s.io"

# ---------- PersistentVolumes ----------
# Cluster-scoped, so not captured by the per-namespace inspection. Needed to see
# the PV backing Central-DB / Scanner-V4-DB (capacity, phase, reclaim policy).
log_msg "Collecting PersistentVolumes..."
inspect_resource "persistentvolumes"

log_msg "--- gather_cluster_scoped: complete ---"
