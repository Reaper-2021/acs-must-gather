#!/bin/bash

# ACS Must-Gather - Advanced: Secured-Cluster Local Diagnostics
#
# Collects diagnostic data directly from the secured-cluster components
# (Sensor, Collector, Admission Controller) WITHOUT depending on Central being
# reachable or an admin login. This is exactly the data that is missing when
# the basic diagnostic-bundle / debug-dump layers fail because Sensor cannot
# reach Central or Central itself is down.
#
# Endpoints are reached with `oc port-forward` to the component pod. Because
# port-forward attaches to the pod's own network namespace, it can reach
# loopback-only debug servers (Sensor's pprof on 127.0.0.1:6060, and its
# cluster-entities store on 127.0.0.1:8099 when it is explicitly enabled) as
# well as the Prometheus metrics port - none of which require credentials.

# shellcheck source=collection-scripts/common.sh
source /usr/bin/common.sh

log_msg "--- gather_advanced_secured_cluster: starting ---"

OUT_DIR="${MUST_GATHER_DIR}/advanced-acs-diagnostics/secured-cluster-local"
mkdir -p "${OUT_DIR}"

# Sensor's debug and metrics servers are plain HTTP; collect_via_pf (from
# common.sh) defaults to the http scheme, so the calls below need no scheme arg.
PF_TIMEOUT="${ADV_SC_TIMEOUT:-${DIAG_TIMEOUT:-30}}"

# Stable Sensor log markers that indicate connectivity / certificate state.
# (These lines are asserted by StackRox tests, so they are safe to grep for.)
# "certificate signed by unknown authority" surfaces CA-rotation breakage where
# Sensor can no longer trust Central or the OpenShift internal registry.
CONNECTIVITY_MARKERS='Connecting to Central|Established connection to Central|Communication with central (started|ended)|different Central installation|not trusted|invalid trust info signature|certificate signed by unknown authority|checking central status over HTTP failed|re-apply Helm config|offline mode|Connected to Sensor'

# Sensor emits this warning once per duplicated pod IP; on high-churn clusters the
# accumulated set is a known driver of Sensor memory growth / OOMKills. We record
# how often it occurs so the analyzer can flag it.
IP_DUP_MARKER='belongs to 2 or more deployments'

while IFS= read -r ns; do
    [[ -z "${ns}" ]] && continue
    if ! resource_exists "deployment/sensor" "${ns}"; then
        continue
    fi

    log_msg "Collecting local secured-cluster diagnostics in ${ns}..."
    ns_dir="${OUT_DIR}/${ns}"
    mkdir -p "${ns_dir}"

    # ---------- Sensor ----------
    sensor_pod=$(oc get pods -n "${ns}" -l app=sensor \
        --field-selector=status.phase=Running \
        -o jsonpath='{.items[0].metadata.name}' 2>/dev/null) || true

    if [[ -n "${sensor_pod}" ]]; then
        log_msg "  Sensor pod: ${sensor_pod}"
        # pprof (loopback 6060)
        collect_via_pf "${ns}" "${sensor_pod}" 6060 "/debug/heap" \
            "${ns_dir}/sensor-heap.pb.gz"
        collect_via_pf "${ns}" "${sensor_pod}" 6060 "/debug/goroutine?debug=2" \
            "${ns_dir}/sensor-goroutine.txt"
        # cluster-entities store (loopback 8099) - Sensor's in-memory view of
        # endpoints / IPs / container IDs. This debug server is only started when
        # Sensor runs with ROX_DEBUG_CLUSTER_ENTITIES_STORE=true (default false),
        # so gate on it - otherwise every normal cluster gets a misleading error.
        ce_enabled=$(oc get deployment/sensor -n "${ns}" \
            -o jsonpath='{range .spec.template.spec.containers[*]}{range .env[*]}{.name}={.value}{"\n"}{end}{end}' 2>/dev/null \
            | grep -E '^ROX_DEBUG_CLUSTER_ENTITIES_STORE=(true|1)$' || true)
        if [[ -n "${ce_enabled}" ]]; then
            collect_via_pf "${ns}" "${sensor_pod}" 8099 "/debug/clusterentities/state.json" \
                "${ns_dir}/sensor-clusterentities-state.json"
        else
            echo "Sensor cluster-entities debug server is not enabled; set ROX_DEBUG_CLUSTER_ENTITIES_STORE=true on the Sensor deployment to capture this." \
                > "${ns_dir}/sensor-clusterentities-state.json.skipped"
        fi
        # Prometheus metrics (plaintext 9090 by default)
        collect_via_pf "${ns}" "${sensor_pod}" 9090 "/metrics" \
            "${ns_dir}/sensor-metrics.txt"

        # Connectivity / certificate triage summary from Sensor logs
        {
            echo "# Sensor connectivity / certificate markers"
            echo "# namespace: ${ns}  pod: ${sensor_pod}"
            echo "# generated: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
            echo
            oc logs -n "${ns}" "${sensor_pod}" -c sensor --tail=-1 2>/dev/null \
                | grep -niE "${CONNECTIVITY_MARKERS}" | tail -200 \
                || echo "(no matching connectivity/cert markers found)"
        } > "${ns_dir}/sensor-connectivity-summary.txt" 2>/dev/null || true

        # Duplicate-IP warning frequency (memory-growth signature). One cheap log
        # pass; records the count plus a few sample lines for context.
        {
            echo "# Sensor duplicate-IP deployment warnings"
            echo "# namespace: ${ns}  pod: ${sensor_pod}"
            echo "# marker: ${IP_DUP_MARKER}"
            echo "# generated: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
            echo
            dup_hits=$(oc logs -n "${ns}" "${sensor_pod}" -c sensor --tail=-1 2>/dev/null \
                | grep -cF "${IP_DUP_MARKER}") || dup_hits=0
            echo "count: ${dup_hits}"
            if [[ "${dup_hits}" -gt 0 ]]; then
                echo
                echo "samples (last 10):"
                oc logs -n "${ns}" "${sensor_pod}" -c sensor --tail=-1 2>/dev/null \
                    | grep -F "${IP_DUP_MARKER}" | tail -10
            fi
        } > "${ns_dir}/sensor-ip-duplication.txt" 2>/dev/null || true
    else
        log_msg "  WARNING: no running Sensor pod in ${ns}"
        echo "no running Sensor pod" > "${ns_dir}/sensor.error"
    fi

    # ---------- Admission Controller ----------
    adm_pod=$(oc get pods -n "${ns}" -l app=admission-control \
        --field-selector=status.phase=Running \
        -o jsonpath='{.items[0].metadata.name}' 2>/dev/null) || true
    if [[ -n "${adm_pod}" ]]; then
        log_msg "  Admission-control pod: ${adm_pod}"
        collect_via_pf "${ns}" "${adm_pod}" 9090 "/metrics" \
            "${ns_dir}/admission-control-metrics.txt"
    fi

    # ---------- Collector ----------
    # Probe/driver type and pod state for every collector pod (cheap, no
    # port-forward), plus metrics from one representative running collector.
    if resource_exists "daemonset/collector" "${ns}"; then
        oc get pods -n "${ns}" -l app=collector -o wide \
            > "${ns_dir}/collector-pods.txt" 2>/dev/null || true
        # COLLECTION_METHOD and last-state per collector pod
        oc get pods -n "${ns}" -l app=collector -o json 2>/dev/null \
            | jq -r '.items[] | .metadata.name as $n
                | "=== \($n) ==="
                , "  collectionMethod: " + ((.spec.containers[]
                    | select(.name=="collector").env // []
                    | map(select(.name=="COLLECTION_METHOD").value) | first) // "unknown")
                , "  restartCount: " + ([.status.containerStatuses[]?
                    | select(.name=="collector").restartCount] | first | tostring)
                , "  lastState: " + ([.status.containerStatuses[]?
                    | select(.name=="collector").lastState | keys[]?] | join(",") )' \
            > "${ns_dir}/collector-status.txt" 2>/dev/null || true

        collector_pod=$(oc get pods -n "${ns}" -l app=collector \
            --field-selector=status.phase=Running \
            -o jsonpath='{.items[0].metadata.name}' 2>/dev/null) || true
        if [[ -n "${collector_pod}" ]]; then
            collect_via_pf "${ns}" "${collector_pod}" 9090 "/metrics" \
                "${ns_dir}/collector-metrics.txt"
        fi
    fi

done <<< "${ACS_NAMESPACES}"

log_msg "--- gather_advanced_secured_cluster: complete ---"
