#!/usr/bin/env bash
# Mock curl for integration tests. Maps Central API paths to recorded fixtures.
# Set MOCK_CURL_FIXTURES_DIR to the fixtures/central-api directory.

fixtures_dir="${MOCK_CURL_FIXTURES_DIR:-}"
output_file=""
write_http_code=false
url=""

args=("$@")
i=0
while [[ $i -lt ${#args[@]} ]]; do
    case "${args[$i]}" in
        -o)
            output_file="${args[$((i + 1))]}"
            i=$((i + 2))
            ;;
        -w)
            write_http_code=true
            i=$((i + 2))
            ;;
        https://*)
            url="${args[$i]}"
            i=$((i + 1))
            ;;
        *)
            i=$((i + 1))
            ;;
    esac
done

path="$(printf '%s' "${url}" | sed -E 's|^https://[^/]+/||' | cut -d'?' -f1)"
fixture_key="${path//\//-}"
fixture_file="${fixtures_dir}/${fixture_key}.json"

body=""
if [[ -n "${fixtures_dir}" && -f "${fixture_file}" ]]; then
    body="$(cat "${fixture_file}")"
elif [[ "${path}" == debug/goroutine ]]; then
    body="goroutine 1 [running]:"
elif [[ "${path}" == debug/heap ]]; then
    body="heap-profile"
else
    body='{"mock":true}'
fi

if [[ -n "${output_file}" ]]; then
    printf '%s' "${body}" > "${output_file}"
else
    printf '%s' "${body}"
fi

if [[ "${write_http_code}" == "true" ]]; then
    printf '200'
fi

exit 0
