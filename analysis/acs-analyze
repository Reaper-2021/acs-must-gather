# Rendering
# ---------------------------------------------------------------------------

def render(bundle, adv, rep):
    print(_bold("ACS must-gather health report"))
    print(f"  bundle : {bundle}")
    print(f"  advanced layer: {'present' if adv else 'not present'}")
    print()

    for r in rep.results:
        line = f"  {_tag(r.status)}  {r.name}"
        if r.detail:
            line += f" - {r.detail}"
        print(line)
        for extra in r.lines:
            print(f"           {extra}")

    counts = {}
    for r in rep.results:
        counts[r.status] = counts.get(r.status, 0) + 1
    print()
    summary = "  ".join(f"{s}={counts.get(s, 0)}" for s in (FAIL, WARN, SKIP, OK, INFO))
    print(_bold("Summary: ") + summary)
    if rep.has_failures():
        print(_bold("Verdict: ") + (_CODES[FAIL] + "FAILING checks present" + _RESET
                                     if _COLOR else "FAILING checks present"))
    elif counts.get(WARN):
        print(_bold("Verdict: ") + "healthy with warnings")
    else:
        print(_bold("Verdict: ") + "healthy")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Health report for an extracted ACS must-gather bundle.")
    parser.add_argument("path", nargs="?", default=".",
                        help="path to the must-gather (default: current dir)")
    parser.add_argument("--image", metavar="SUBSTRING", default=None,
                        help="drill into image-scan CVEs for images whose name "
                             "contains SUBSTRING (from vuln-report/)")
    args = parser.parse_args(argv)

    bundle = discover_bundle(args.path)
    if not bundle:
        sys.stderr.write(
            f"error: could not find an ACS must-gather under '{args.path}'.\n"
            "       Point me at the extracted must-gather directory.\n")
        return 2

    adv_dir = os.path.join(bundle, "advanced-acs-diagnostics")
    adv = adv_dir if os.path.isdir(adv_dir) else None

    rep = Report()
    central_ver = check_versions(bundle, rep)
    check_central_db(bundle, rep)
    check_clusters(bundle, rep, central_ver)
    check_upgrade_status(bundle, rep)
    check_collection_errors(adv, rep)
    check_connectivity(adv, rep)
    check_certs(adv, rep)
    check_heap(adv, bundle, rep)
    check_goroutines(adv, bundle, rep)
    check_collector(adv, rep)
    check_scanner_v4(adv, rep)
    check_image_cves(adv, rep, image_filter=args.image)
    check_violations(adv, rep)
    check_admin_events(adv, rep)
    check_crashes(adv, bundle, rep)

    render(bundle, adv, rep)
    return 1 if rep.has_failures() else 0


if __name__ == "__main__":
    sys.exit(main())
