def check_versions(bundle, rep):
    """Central version, license status, and Central<->Sensor version skew."""
    meta = read_json(os.path.join(bundle, "acs-diagnostics", "central-metadata.json"))
    versions = read_json(os.path.join(bundle, "acs-diagnostic-bundle", "versions.json")) \
        or read_json(os.path.join(bundle, "acs-debug-dump", "versions.json"))

    central_ver = None
    lines = []
    if meta:
        central_ver = meta.get("version")
        lines.append(f"Central: {central_ver}  (flavor={meta.get('buildFlavor')}, "
                     f"release={meta.get('releaseBuild')})")
    if versions:
        central_ver = central_ver or versions.get("MainVersion")
        lines.append(f"Main={versions.get('MainVersion')}  "
                     f"Collector={versions.get('CollectorVersion')}  "
                     f"Scanner={versions.get('ScannerVersion')}  "
                     f"DB={versions.get('Database')} {versions.get('DatabaseServerVersion')}")
    if not lines:
        rep.add("Versions", SKIP, "no central-metadata.json / versions.json found")
        return central_ver

    # License gate.
    lic = (meta or {}).get("licenseStatus")
    if lic and lic != "VALID":
        rep.add("License", FAIL, f"Central license status is {lic}")
    elif lic:
        rep.add("License", OK, "license VALID")

    rep.add("Versions", OK if central_ver else INFO,
            f"Central {central_ver}" if central_ver else "version data present",
            lines)
    return central_ver


def check_central_db(bundle, rep):
    st = read_json(os.path.join(bundle, "acs-diagnostics", "central-db-status.json"))
    if st is None:
        rep.add("Central DB", SKIP, "central-db-status.json not found")
        return
    if st.get("databaseAvailable") is True:
        ext = " (external)" if st.get("databaseIsExternal") else ""
        rep.add("Central DB", OK,
                f"available - {st.get('databaseType')} {st.get('databaseVersion')}{ext}")
    else:
        rep.add("Central DB", FAIL, f"databaseAvailable={st.get('databaseAvailable')}")


def check_clusters(bundle, rep, central_ver):
    data = read_json(os.path.join(bundle, "acs-diagnostics", "central-clusters.json"))
    if data is None:
        rep.add("Secured Clusters", SKIP, "central-clusters.json not found")
        return
    clusters = data.get("clusters", []) if isinstance(data, dict) else []
    if not clusters:
        rep.add("Secured Clusters", WARN, "Central reports zero connected clusters")
        return

    lines = []
    worst = OK
    for c in clusters:
        name = c.get("name", "?")
        cm = c.get("collectionMethod", "?")
        sver = (c.get("status") or {}).get("sensorVersion", "?")
        note = ""
        if cm not in ("CORE_BPF", "EBPF"):
            worst = _worse(worst, WARN)
            note += f"  collectionMethod={cm}(!)"
        if central_ver and sver not in ("?", None) and sver != central_ver:
            worst = _worse(worst, WARN)
            note += f"  sensor {sver} != central {central_ver}(skew)"
        lines.append(f"{name}: collector={cm}, sensor={sver}{note}")

    rep.add("Secured Clusters", worst,
            f"{len(clusters)} connected", lines)


def check_upgrade_status(bundle, rep):
    data = read_json(os.path.join(bundle, "acs-diagnostics", "central-upgrade-status.json"))
    if data is None:
        return  # optional, no noise
    us = data.get("upgradeStatus", data) if isinstance(data, dict) else {}
    rep.add("Upgrade status", INFO,
            f"version={us.get('version')}, "
            f"forceRollbackTo={us.get('forceRollbackTo')}")


def check_collection_errors(adv, rep):
    if not adv:
        return
    errs = []
    for root, _dirs, files in os.walk(adv):
        for f in files:
            if f.endswith(".error"):
                errs.append(os.path.relpath(os.path.join(root, f), adv))
    if not errs:
        rep.add("Collection errors", OK, "no .error files in advanced layer")
    else:
        rep.add("Collection errors", WARN,
                f"{len(errs)} .error file(s) - some collectors could not reach a target",
                sorted(errs)[:12])


def check_connectivity(adv, rep):
    if not adv:
        return
    matches = glob.glob(os.path.join(adv, "secured-cluster-local", "*",
                                     "sensor-connectivity-summary.txt"))
    if not matches:
        rep.add("Sensor connectivity", SKIP, "no sensor-connectivity-summary.txt")
        return
    bad_markers = [
        ("not trusted", "cert/CA mismatch"),
        ("invalid trust info signature", "cert/CA mismatch"),
        ("different Central installation", "Sensor points at a re-installed Central"),
        ("checking central status over HTTP failed", "network/DNS/Central-down"),
        ("offline mode", "Sensor lost Central and is buffering"),
    ]
    for path in matches:
        ns = os.path.basename(os.path.dirname(path))
        txt = read_text(path) or ""
        established = "Established connection to Central" in txt
        hits = sorted({label for marker, label in bad_markers
                       if re.search(re.escape(marker), txt, re.IGNORECASE)})
        if hits:
            rep.add(f"Sensor connectivity [{ns}]", FAIL,
                    "; ".join(hits))
        elif established:
            rep.add(f"Sensor connectivity [{ns}]", OK,
                    "Established connection to Central")
        else:
            rep.add(f"Sensor connectivity [{ns}]", WARN,
                    "no 'Established connection' line and no known error marker")


def check_certs(adv, rep):
    if not adv:
        return
    path = os.path.join(adv, "tls-certs", "cert-expiry-summary.txt")
    txt = read_text(path)
    if txt is None:
        rep.add("TLS certs", SKIP, "cert-expiry-summary.txt not found")
        return
    expired, warning = [], []
    current = "?"
    for line in txt.splitlines():
        m = re.match(r"=== (.+?) ===", line)
        if m:
            current = m.group(1)
        elif line.startswith("status: EXPIRED"):
            expired.append(current)
        elif line.startswith("status: WARNING"):
            warning.append(current)
    if expired:
        rep.add("TLS certs", FAIL,
                f"{len(expired)} EXPIRED certificate(s)", expired[:12])
    elif warning:
        rep.add("TLS certs", WARN,
                f"{len(warning)} cert(s) expire within 30 days", warning[:12])
    elif "===" in txt:
        rep.add("TLS certs", OK, "all decoded certs valid (>30d)")
    else:
        rep.add("TLS certs", SKIP, "no RHACS certificates were decoded")


def _pprof_total_bytes(path):
    """Return live-heap total bytes from a pprof heap profile, or None."""
    go = shutil.which("go")
    if not go or not os.path.exists(path):
        return None
    try:
        out = subprocess.run(
            [go, "tool", "pprof", "-inuse_space", "-top", "-nodecount=1", path],
            capture_output=True, text=True, timeout=60,
        ).stdout
    except (subprocess.SubprocessError, OSError):
        return None
    # "Showing nodes accounting for 137.81MB, 72.86% of 189.15MB total"
    m = re.search(r"of\s+([0-9.]+)([kKmMgG]?B)\s+total", out)
    if not m:
        return None
    val, unit = float(m.group(1)), m.group(2).upper()
    mult = {"B": 1, "KB": 1024, "MB": 1024**2, "GB": 1024**3}.get(unit, 1)
    return val * mult


def check_heap(adv, bundle, rep):
    go_present = shutil.which("go") is not None
    # Sensor heap (advanced layer) is the most actionable.
    sensor_heaps = glob.glob(os.path.join(adv or "", "secured-cluster-local", "*",
                                          "sensor-heap.pb.gz")) if adv else []
    central_heap = first_existing(
        os.path.join(bundle, "acs-diagnostics", "central-heap-profile.pb.gz"),
        os.path.join(bundle, "acs-diagnostic-bundle", "heap.pb.gz"),
    )
    # Each target: (label, path, ns, name_glob, container, exclude) so we can
    # look up the owning pod's memory limit and warn on the real percentage.
    targets = []
    for p in sensor_heaps:
        ns = os.path.basename(os.path.dirname(p))
        targets.append((f"sensor heap [{ns}]", p, ns, "sensor-*", "sensor", ()))
    if central_heap:
        targets.append(("central heap", central_heap, None, "central-*",
                        "central", ("central-db",)))
    if not targets:
        rep.add("Heap profiles", SKIP, "no heap profiles found")
        return
    if not go_present:
        rep.add("Heap profiles", SKIP,
                f"{len(targets)} heap profile(s) present but `go` not installed "
                "(install Go to read them)")
        return
    for label, path, ns, name_glob, container, exclude in targets:
        total = _pprof_total_bytes(path)
        if total is None:
            rep.add(label, SKIP, "could not parse pprof output")
            continue
        limit = pod_mem_limit(bundle, ns, name_glob, container, exclude)
        if limit:
            pct = total / limit
            if pct >= 0.90:
                status = FAIL
            elif pct >= 0.75:
                status = WARN
            else:
                status = OK
            rep.add(label, status,
                    f"live heap {human_bytes(total)} of {human_bytes(limit)} "
                    f"limit ({pct:.0%})")
        else:
            # No limit in the manifest: report, warn only if very large.
            status = WARN if total > 2 * 1024**3 else INFO
            rep.add(label, status,
                    f"live heap {human_bytes(total)} (no pod memory limit found)")


def check_goroutines(adv, bundle, rep):
    targets = []
    if adv:
        targets += [(f"sensor goroutines [{os.path.basename(os.path.dirname(p))}]", p)
                    for p in glob.glob(os.path.join(
                        adv, "secured-cluster-local", "*", "sensor-goroutine.txt"))]
    central_gr = first_existing(
        os.path.join(bundle, "acs-diagnostics", "central-goroutine-dump.txt"),
        os.path.join(bundle, "acs-diagnostic-bundle", "goroutine.txt"),
    )
    if central_gr:
        targets.append(("central goroutines", central_gr))
    if not targets:
        rep.add("Goroutines", SKIP, "no goroutine dumps found")
        return
    for label, path in targets:
        txt = read_text(path) or ""
        count = len(re.findall(r"(?m)^goroutine ", txt))
        if count == 0:
            rep.add(label, SKIP, "empty / unrecognised goroutine dump")
        elif count > 20000:
            rep.add(label, FAIL, f"{count} goroutines - likely a goroutine leak")
        elif count > 8000:
            rep.add(label, WARN, f"{count} goroutines - high, watch for a leak")
        else:
            rep.add(label, OK, f"{count} goroutines")


def check_collector(adv, rep):
    if not adv:
        return
    for path in glob.glob(os.path.join(adv, "secured-cluster-local", "*",
                                       "collector-status.txt")):
        ns = os.path.basename(os.path.dirname(path))
        txt = read_text(path) or ""
        pods = re.findall(r"=== (.+?) ===", txt)
        methods = re.findall(r"collectionMethod:\s*(\S+)", txt)
        restarts = [int(x) for x in re.findall(r"restartCount:\s*(\d+)", txt)]
        laststates = re.findall(r"lastState:\s*(\S+)", txt)
        bad_method = [m for m in methods if m not in ("CORE_BPF", "EBPF")]
        max_restart = max(restarts) if restarts else 0
        oom = any("OOM" in s or "Terminated" in s for s in laststates)
        detail = f"{len(pods)} collector pod(s), method(s)={sorted(set(methods)) or '?'}, " \
                 f"max restarts={max_restart}"
        if oom or bad_method:
            rep.add(f"Collector [{ns}]", WARN, detail)
        elif max_restart > 5:
            rep.add(f"Collector [{ns}]", WARN, detail + " - restart churn")
        else:
            rep.add(f"Collector [{ns}]", OK, detail)


def check_admin_events(adv, rep):
    if not adv:
        return
    path = os.path.join(adv, "crash-upgrade-forensics", "administration-events.json")
    data = read_json(path)
    if data is None:
        return  # best-effort; absence is normal
    events = data.get("events", data) if isinstance(data, dict) else data
    if not isinstance(events, list):
        rep.add("Admin events", SKIP, "unrecognised administration-events.json")
        return
    levels = {}
    for e in events:
        lvl = (e.get("level") or "UNKNOWN").replace("ADMINISTRATION_EVENT_LEVEL_", "")
        levels[lvl] = levels.get(lvl, 0) + 1
    errs = levels.get("ERROR", 0)
    detail = ", ".join(f"{k}={v}" for k, v in sorted(levels.items())) or "none"
    if errs:
        rep.add("Admin events", WARN, f"{errs} ERROR event(s) ({detail})")
    else:
        rep.add("Admin events", OK, detail)


def check_scanner_v4(adv, rep):
    if not adv:
        return
    statuses = glob.glob(os.path.join(adv, "scanner-v4", "*",
                                      "scanner-v4-status.txt"))
    if not statuses:
        return  # Scanner V4 not deployed or not collected - stay quiet.
    for path in statuses:
        ns = os.path.basename(os.path.dirname(path))
        txt = read_text(path) or ""
        not_ready, max_restart = [], 0
        for block in re.split(r"(?m)^=== ", txt):
            block = block.strip()
            if not block or block.startswith("#"):
                continue
            name = block.splitlines()[0].split("[")[0].replace("===", "").strip()
            rc = re.search(r"restarts:\s*(\d+)", block)
            if rc:
                max_restart = max(max_restart, int(rc.group(1)))
            ready = re.search(r"ready:\s*(\w+)", block)
            if ready and ready.group(1).lower() == "false":
                not_ready.append(name)
        detail = f"max restarts={max_restart}"
        if not_ready:
            rep.add(f"Scanner V4 [{ns}]", WARN,
                    f"{len(not_ready)} pod(s) not ready", not_ready[:12])
        elif max_restart > 5:
            rep.add(f"Scanner V4 [{ns}]", WARN, detail + " - restart churn")
        else:
            rep.add(f"Scanner V4 [{ns}]", OK, detail)


