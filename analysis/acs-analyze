#!/usr/bin/env python3
"""acs-analyze - health report for an ACS must-gather bundle.

Reads an extracted acs-must-gather (produced by the acs-must-gather image) and
prints a health report that automates the "is this cluster healthy?" checklist
from the README. It runs entirely offline against the extracted files - it never
contacts a cluster.

Usage:
    acs-analyze [PATH]

PATH may point at the must-gather root, the image sub-directory
(quay-io-...-acs-must-gather-sha256-...), or the directory is auto-discovered
from the current directory when omitted.

Exit codes:
    0  no failing checks (warnings are allowed)
    1  at least one check FAILED
    2  usage / could not locate a bundle

Requires: python3 (stdlib only). `go` is used, when present, to read the
sensor/central heap profiles via `go tool pprof`; without it those checks SKIP.
"""

import argparse
import glob
import json
import os
import re
import shutil
import subprocess
import sys

# ---------------------------------------------------------------------------
# Result model
# ---------------------------------------------------------------------------

OK, WARN, FAIL, SKIP, INFO = "OK", "WARN", "FAIL", "SKIP", "INFO"

# Ordering / severity so the summary can rank the worst first.
_RANK = {FAIL: 0, WARN: 1, SKIP: 2, INFO: 3, OK: 4}


class Result:
    def __init__(self, name, status, detail="", lines=None):
        self.name = name
        self.status = status
        self.detail = detail
        self.lines = lines or []  # extra indented lines


class Report:
    def __init__(self):
        self.results = []

    def add(self, name, status, detail="", lines=None):
        self.results.append(Result(name, status, detail, lines))
        return self.results[-1]

    def has_failures(self):
        return any(r.status == FAIL for r in self.results)


# ---------------------------------------------------------------------------
# Terminal colouring
# ---------------------------------------------------------------------------

def _use_color():
    if os.environ.get("NO_COLOR"):
        return False
    return sys.stdout.isatty()


_COLOR = _use_color()
_CODES = {
    OK: "\033[32m",     # green
    WARN: "\033[33m",   # yellow
    FAIL: "\033[31m",   # red
    SKIP: "\033[90m",   # grey
    INFO: "\033[36m",   # cyan
}
_RESET = "\033[0m"
_BOLD = "\033[1m"


def _tag(status):
    label = f"[{status:>4}]"
    if _COLOR and status in _CODES:
        return f"{_CODES[status]}{label}{_RESET}"
    return label


def _bold(s):
    return f"{_BOLD}{s}{_RESET}" if _COLOR else s


# ---------------------------------------------------------------------------
# Bundle discovery + small helpers
# ---------------------------------------------------------------------------

# Sub-directories that mark a must-gather image directory.
_MARKERS = (
    "acs-diagnostics",
    "acs-diagnostic-bundle",
    "acs-debug-dump",
    "advanced-acs-diagnostics",
    "namespaces",
)


def _looks_like_bundle(path):
    return any(os.path.isdir(os.path.join(path, m)) for m in _MARKERS)


def discover_bundle(start):
    """Return the image sub-directory that holds the must-gather data."""
    start = os.path.abspath(start)
    if os.path.isfile(start):
        start = os.path.dirname(start)
    if _looks_like_bundle(start):
        return start
    # Look one or two levels down (must-gather.local.XXXX/quay-.../).
    for depth in ("*", os.path.join("*", "*")):
        for cand in sorted(glob.glob(os.path.join(start, depth))):
            if os.path.isdir(cand) and _looks_like_bundle(cand):
                return cand
    return None


def read_json(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError:
        return None


def first_existing(*paths):
    for p in paths:
        if p and os.path.exists(p):
            return p
    return None


def human_bytes(n):
    try:
        n = float(n)
    except (TypeError, ValueError):
        return str(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if abs(n) < 1024.0:
            return f"{n:.1f}{unit}"
        n /= 1024.0
    return f"{n:.1f}PB"


# Kubernetes quantity suffixes -> multiplier (binary Ki/Mi/... and decimal k/M/...).
_QTY = {
    "": 1, "k": 1000, "K": 1000, "M": 1000**2, "G": 1000**3,
    "T": 1000**4, "P": 1000**5,
    "Ki": 1024, "Mi": 1024**2, "Gi": 1024**3, "Ti": 1024**4, "Pi": 1024**5,
}


def mem_to_bytes(s):
    """Convert a Kubernetes memory quantity (e.g. '4Gi', '512Mi', '2000000') to bytes."""
    m = re.match(r'^\s*"?(\d+(?:\.\d+)?)\s*([EPTGMK]i?|[kKMGTP]?)"?\s*$', str(s))
    if not m:
        return None
    val, suffix = float(m.group(1)), m.group(2)
    mult = _QTY.get(suffix)
    return int(val * mult) if mult else None


def container_mem_limit(yaml_text, container):
    """Best-effort: memory limit (bytes) for the named container in a pod manifest.

    Stdlib only, so this is an indentation-aware scan rather than a real YAML
    parse. `oc get -o yaml` sorts keys alphabetically, so a container list item
    starts with `- <firstkey>:` (e.g. `- command:`) and carries `name:` as a
    plain key. We split the `containers:` list into per-item blocks, pick the
    block whose `name:` matches, then read its `limits:`/`memory:`.
    """
    lines = yaml_text.splitlines()
    n = len(lines)

    # Locate the spec-level `containers:` key.
    cidx = cindent = None
    for i, ln in enumerate(lines):
        m = re.match(r'^(\s*)containers:\s*$', ln)
        if m:
            cidx, cindent = i, len(m.group(1))
            break
    if cidx is None:
        return None

    # Determine the list-item ("- ") indent from the first item after the key.
    dash = None
    for ln in lines[cidx + 1:]:
        if not ln.strip():
            continue
        m = re.match(r'^(\s*)-\s', ln)
        if m and len(m.group(1)) >= cindent:
            dash = len(m.group(1))
        break
    if dash is None:
        return None

    # Split the list into per-item blocks.
    blocks, cur = [], None
    for ln in lines[cidx + 1:]:
        if not ln.strip():
            if cur is not None:
                cur.append(ln)
            continue
        ind = len(ln) - len(ln.lstrip())
        if ind == dash and re.match(r'^\s*-\s', ln):
            if cur is not None:
                blocks.append(cur)
            cur = [ln]
        elif ind > dash:
            if cur is not None:
                cur.append(ln)
        else:
            break  # dedented out of the containers list
    if cur is not None:
        blocks.append(cur)

    for blk in blocks:
        joined = "\n".join(blk)
        # `name:` is usually a plain key, but may sit on the `- ` item line when
        # it is the alphabetically-first key of the container.
        if not re.search(rf'(?m)^\s*(?:-\s+)?name:\s*"?{re.escape(container)}"?\s*$',
                         joined):
            continue
        in_limits = False
        for bl in blk:
            s = bl.strip()
            if s.startswith("limits:"):
                in_limits = True
                continue
            if s.startswith("requests:"):
                in_limits = False
                continue
            if in_limits:
                mm = re.match(r'^memory:\s*(.+)$', s)
                if mm:
                    return mem_to_bytes(mm.group(1))
    return None


def pod_mem_limit(bundle, ns, name_glob, container, exclude=()):
    """Find a pod matching name_glob under namespaces/<ns>/ and return its
    container memory limit in bytes, or None."""
    base = os.path.join(bundle, "namespaces", ns if ns else "*", "pods",
                        name_glob, "*.yaml")
    for yml in sorted(glob.glob(base)):
        d = os.path.basename(os.path.dirname(yml))
        if any(d.startswith(x) for x in exclude):
            continue
        txt = read_text(yml)
        if not txt:
            continue
        lim = container_mem_limit(txt, container)
        if lim:
            return lim
    return None


